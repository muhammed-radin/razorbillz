{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "NODE_ENV=development nodemon app.js",
    "devwin": "set NODE_ENV=development && nodemon app.js",
    "test": "node --test \"tests/*.test.js\"",
    "db:drop-collections": "node scripts/drop-all-collections.js",
    "keys:generate": "node scripts/generate-master-keys.js",
    "keys:rotate": "node scripts/generate-master-keys.js --rotate",
    "migrate:encryption": "node scripts/migrate-encryption.js",
    "migrate:encryption:dry": "node scripts/migrate-encryption.js --dry"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@better-auth/mongo-adapter": "^1.7.1",
    "agenda": "^6.2.6",
    "agendash": "^8.2.4",
    "better-auth": "^1.7.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "ejs": "^7.0.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^9.14.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.0.1",
    "morgan": "^1.11.0",
    "nodemailer": "^10.2.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1"
  }
}

# Frontend — copy to .env and fill. NEVER commit real secrets.
# Dev only: the backend runs as a separate server. Production builds read
# `.env.production`, where VITE_API_ENDPOINT is empty so requests stay on the
# same origin as the Express-hosted frontend.
VITE_API_ENDPOINT=http://localhost:3000
VITE_CRYPTED=
VITE_CRYPTED_STRICT=

# Razorpay Checkout needs ONLY the public Key ID (test: rzp_test_*).
# NEVER put RAZORPAY_KEY_SECRET or webhook secrets in frontend env.
VITE_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER

# Firebase (existing usage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
